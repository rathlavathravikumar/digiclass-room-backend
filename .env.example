# MongoDB connection string
# For a cloud Atlas connection, use mongodb+srv://<user>:<password>@cluster.example.net/?retryWrites=true&w=majority
# If the password contains special characters like @, /, or :, percent-encode them.
# Example: password "digi-classroom@2026" becomes "digi-classroom%402026"
MONGODB_URI=mongodb+srv://digiclassroom-admin:digi-classroom%402026@digiclassroom.oen9jsx.mongodb.net/?appName=DigiClassRoom

# App configuration
PORT=3001
FRONTEND_URL=http://localhost:8080

# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# JWT secrets and expiry values
ACCESS_TOKEN_SECRET=replace_this_with_a_strong_secret
REFRESH_TOKEN_SECRET=replace_this_with_a_strong_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Email / SMTP settings
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloudinary settings for file uploads
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Optional Jitsi meeting service settings
JITSI_BASE_URL=https://meet.jit.si/
JITSI_APP_ID=
JITSI_JWT_SECRET=
